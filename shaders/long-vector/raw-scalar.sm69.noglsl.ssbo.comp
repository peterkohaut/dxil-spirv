ByteAddressBuffer Input : register(t0);
RWByteAddressBuffer Output : register(u0);

[numthreads(1, 1, 1)]
void main(uint index : SV_DispatchThreadID)
{
	uint offset = index * 68 + 4;
	vector<float, 16> value = Input.Load<vector<float, 16> >(offset);
	Output.Store<vector<float, 16> >(offset, value + 1);
}
